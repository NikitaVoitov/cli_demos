#!/bin/bash
# git credential helper in the capture home: answers for github.com with the demo repo's token, nothing else.
[ "$1" = "get" ] || exit 0
set -a
. "$HOME/.config/gh-demo.env"
set +a
host=""
while IFS= read -r line && [ -n "$line" ]; do
  case "$line" in host=*) host="${line#host=}" ;; esac
done
[ "$host" = "github.com" ] || exit 0
echo "username=x-access-token"
echo "password=$GH_TOKEN"
