#!/usr/bin/python3
"""splunkctl in the capture home, for demos whose approval gate is elsewhere (SO-08 gates containment in n8n-contain).

splunkctl holds every search job for confirmation, reads included. This wrapper confirms a `search` whose SPL has
no command that writes or sends data; every other write still stops at CONFIRMATION_REQUIRED.
"""

import os
import re
import sys

REAL = "/usr/local/bin/splunkctl"
WRITES = re.compile(r"\|\s*(?:collect|tscollect|mcollect|meventcollect|outputlookup|outputcsv|outputtext|sendemail"
                    r"|sendalert|delete|script|run|dbxoutput|dbxquery|map)\b", re.I)

VALUED = {"-o", "--output", "--host", "--token", "--timeout", "--param"}

args = sys.argv[1:]
words, skip = [], False
for a in args:
    if skip:
        skip = False
    elif a in VALUED:
        skip = True
    elif not a.startswith("-"):
        words.append(a)
is_search = bool(words) and words[0] == "search"
confirm = ["--yes"] if is_search and not any(WRITES.search(a) for a in args) and "--yes" not in args else []
os.execv(REAL, [REAL, "--insecure", *confirm, *args])
