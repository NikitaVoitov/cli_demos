[0.3, "o", "\u001b[2mfixture\u001b[0m $ # Test fixture for the workflow canvas, not a real capture\r\n"]
[1.5, "o", "\u001b[2mfixture\u001b[0m $ Triage the new email in the Phishing reports folder.\r\n"]
[3.0, "o", "\u001b[1m\u25cf\u001b[0m Outlook MCP: 1 report  \u001b[2m\"Invoice overdue: action required\"\u001b[0m\r\n"]
[6.0, "o", "\u001b[1m\u25cf\u001b[0m Splunk MCP: | aiagent phishing_triage  \u001b[2m(Agent Launchpad)\u001b[0m\r\n"]
[9.0, "o", "  \u001b[2m\u2514 14 recipients, 3 clicked the link, no payload ran\u001b[0m\r\n"]
[11.0, "o", "\u001b[1m\u25cf\u001b[0m Recommend: purge the email, block the sender domain.\r\n"]
[14.0, "o", "\u001b[1m\u25cf\u001b[0m n8n-contain --case PH-1042\r\n"]
[15.5, "o", "  \u001b[33m\u2514 CONFIRMATION_REQUIRED\u001b[0m\r\n"]
[16.5, "o", "\u001b[1m\u25cf\u001b[0m Containment needs your approval.\r\n"]
[18.0, "o", "\u001b[2mfixture\u001b[0m $ Approved.\r\n"]
[20.0, "o", "\u001b[1m\u25cf\u001b[0m n8n-contain --case PH-1042 --yes\r\n"]
[26.5, "o", "  \u001b[32m\u2514 contained; analyst notified in Slack\u001b[0m\r\n"]
[28.0, "o", "\u001b[2mfixture\u001b[0m $ Slack says it's done. Check in Splunk that it worked.\r\n"]
[30.0, "o", "\u001b[1m\u25cf\u001b[0m Splunk MCP: | aiagent phishing_triage verify  \u001b[2m(Agent Launchpad)\u001b[0m\r\n"]
[32.0, "o", "  \u001b[2m\u2514 0 mailboxes still hold the email, 0 clicks since containment\u001b[0m\r\n"]
[34.0, "o", "\u001b[1m\u25cf\u001b[0m Contained and verified.\r\n"]
[36.0, "o", "\u001b[2mfixture\u001b[0m $ \r\n"]
