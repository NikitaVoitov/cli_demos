[149.069862, "o", ";32;32;32;1m╚══════════════════════════════════════════════════════════════════════════════════════════════════════════╝\u001b[0;38;2;87;87;87;48;2;32;32;32m \u001b[0m\r\r\n\u001b[0;38;2;87;87;87;48;2;32;32;32m \u001b[0;38;2;240;240;240;48;2;32;32;32;1m                                                                                                            \u001b[0;38;2;87;87;87;48;2;32;32;32m \u001b[0m\r\r\n\u001b[0;38;2;87;87;87;48;2;32;32;32m \u001b[0;38;2;240;240;240;48;2;32;32;32;1mHypothesis.\u001b[0;38;2;240;240;240;48;2;32;32;32m One source IP tries a single password against many accounts, slowly enough that the alert on    \u001b[0;38;2;87;87;87;48;2;32;32;32m \u001b[0m\r\r\n\u001b[0;38;2;87;87;87;48;2;32;32;32m \u001b[0;38;2;240;240;240;48;2;32;32;32m100 failures in 5 minutes never fires. The hot index keeps 14 days; the Machine Data Lake keeps the rest.   \u001b"]
