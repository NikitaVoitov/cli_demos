[65.359606, "o", "─────────────────────────────────────────┤\r\n\u001b[3C│\u001b[m Search    \u001b[90m│\u001b[m The where clause is exactly as sigma-cli printed it, wrapped in our template with the    \u001b[90m│\r\n\u001b[5C\u001b[m          \u001b[90m│\u001b[m standard by fields and the `process_memory_dump_via_comsvcs_dll_filter   \u001b[16C\u001b[90m│\u001b[26;16H┴────\u001b[26;90H─────────────────┘\u001b[32;2H\u001b[34m●\u001b[m \u001b[34mWo\u001b[m\u001b[30;3H\u001b[?25h"]
[65.393222, "o", "\u001b[?25l\u001b[3;25r\u001b[25;1H\r\n\r\n\r\n\u001b[r\u001b[20;110H┃\r\r\n\u001b[109C┃\r\u001b[22;45Hprocess_memory_dump_via_comsvcs_dll_filter macro last\u001b[12C┃\r\r\n   \u001b[90m├───────────┼──────────────────────────────────────────────────────────────────────────────────────────┤\u001b[m  \u001b[37m┃\r\r\n\u001b[3C\u001b[90m│\u001b[m Filter    \u001b[90m│\u001b[m search *, so there\u001b[71C\u001b[90m│\u001b[m  \u001b[37m┃\r\r\n\u001b[3C\u001b[90m│\u001b[m macro\u001b[5C\u001b[90m│\u001b[90C│\u001b[m  \u001b[37m┃\u001b[m\r\u001b[5B❯ \u001b[?25h"]
