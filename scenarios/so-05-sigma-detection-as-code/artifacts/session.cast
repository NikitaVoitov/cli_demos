[65.359589, "o", "\u001b[?25l\u001b[3;14r\u001b[14;1H\r\n\r\n\r\n\u001b[r\u001b[9;16H\u001b[90m┬────\u001b[9;90H─────────────────┐\u001b[10;15H\u001b[m \u001b[90m│\u001b[m \u001b[1mValue    \u001b[10;89H                 \u001b[m \u001b[90m│\u001b[11;16H┼────\u001b[11;90H─────────────────┤\r\n\u001b[3C│\u001b[m Name\u001b[6C\u001b[90m│\u001b[m Process Memory Dump Via Comsvcs DLL\u001b[54C\u001b[90m│\u001b[m  ┃\r\r\n   \u001b[90m├───────────┼──────────────────────────────────────────────────────────────────────────────────────────┤\u001b[m  ┃\r\r\n   \u001b[90m│\u001b[m Sigma\u001b[5C\u001b[90m│\u001b[m 646ea171-dded-4578-8a4d-65e9822892e3, whose id the detection reuses\u001b[22C\u001b[90m│\u001b[m  ┃\r\r\n\u001b[5Crul\u001b[7C\u001b[90m│\u001b[m                                        \u001b[15;90H \u001b[16C\u001b[90m│\u001b[16;16H┼────\u001b[16;90H─────────────────┤\r\n\u001b[5C\u001b[mTechnique \u001b[90m│\u001b["]
