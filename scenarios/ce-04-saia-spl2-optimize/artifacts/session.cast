[109.577549, "o", "\u001b[?25l\r\n\r\n \u001b[1m←\u001b[m open sidebar · Interactive · Manual Approval · \u001b[1m/\u001b[m commands · \u001b[1m?\u001b[m help · \u001b[1mtab\u001b[m next tab\u001b[38;3H\u001b[?25h"]
[109.613528, "o", "\u001b[?25l\u001b[3;36r\u001b[36;1H\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[r\u001b[15;110H┃\r\r\n\u001b[109C┃\r\r\n\u001b[109C┃\r\r\n\u001b[109C┃\r\r\n\u001b[109C┃\r\r\n\u001b[109C┃\r\r\n\u001b[109C┃\r\r\n \u001b[33m$\u001b[m \u001b[1mShell \u001b[mprintf 'SAIA SPL2 - complete listing\\n'; cat optimized_login_failure_rate.spl2 12 lines\u001b[13C┃\r\r\n \u001b[90m│\u001b[m SAIA SPL2 - complete listing\u001b[78C┃\r\r\n \u001b[90m│\u001b[m @spl2 from index:demo_soc\u001b[81C┃\r\r\n \u001b[90m│\u001b[m | where sourcetype=\"portal:auth\"\u001b[74C┃\r\r\n \u001b[90m│\u001b[m | stats count() as attempts,\u001b[78C┃\r\r\n \u001b[90m│\u001b[5C\u001b[msum(if(result=\"failure\", 1, 0))\u001b[71C┃\r\r\n \u001b[90m│\u001b[5C\u001b[mas failures\u001b[91C┃\r\r\n \u001b[90m│\u001b[5C\u001b[mby service, version\u001b[83C\u001b[37m┃\r\r\n\u001b[C\u001b[90m│\u001b[m | eval failure_rate=\u001b[86C\u001b[37m┃\r\r\n\u001b[C\u001b[90m│\u001b[5C\u001b[mround(100*failures/attempts, 1)\u001b[71C\u001b[37m┃\r\r\n\u001b[C\u001b[90m│\u001b[m | fields service, version, attempts,\u001b[70C\u001b[37m┃\r\r\n\u001b[C\u001b[90m│\u001b[5C\u001b[mfailures, failure_rate\u001b[80C\u001b[37m┃\r\r\n\u001b[C\u001b[90m│\u001b[m | sort -failure_rate\u001b[86C\u001b[37m┃\r\r\n\u001b[109C┃\r\r\n\u001b[C\u001b[m~/payments\r\n\r\n❯ \u001b[?25h"]
