[14.701678, "o", "─────────────────────────────────────────────────────────╯\u001b[m \u001b[37m┃\r\r\n\u001b[108C\u001b[m\u001b[1K \u001b[37m┃\r\r\n\u001b[m \u001b[33m$\u001b[m \u001b[1mShell \u001b[mprintf 'BASELINE SPL2 - complete listing\\n'; cat login_failure_rate.spl2 23 lines\u001b[17C  \u001b[37m┃\r\r\n\u001b[m \u001b[90m│\u001b[m BASELINE SPL2 - complete listing                          \u001b[46C  \u001b[37m┃\r\r\n\u001b[m \u001b[90m│\u001b[m @spl2 search index=*                      \u001b[62C  \u001b[37m┃\r\r\n\u001b[m \u001b[90m│\u001b[m | where sourcetype=\"portal:auth\" \u001b[71C  \u001b[37m┃\r\r\n\u001b[m \u001b[90m│\u001b[m | eval is_failure=if(result=\"failure\", 1, 0)                                                              \u001b[37m┃\r\r\n\u001b[C\u001b[90m│\u001b[m | stats count() AS attempts\u001b[79C\u001b[37m┃\r\r\n\u001b[C\u001b[90m│\u001b[5C\u001b[mBY service, version\u001b[83C\u001b[37m┃\r\r\n\u001b[C\u001b[90m│\u001b[m | join left=L right=R\u001b[85C\u001b[37m┃\r\r\n\u001b[C\u001b[90m│\u001b[5C\u001b[mwhere L.service=R.service\u001b[77C\u001b[37m┃\r\r\n\u001b[C\u001b[90m│\u001b[7C\u001b[mAND L.version=R.version\u001b[77C\u001b[37m┃\r\r\n\u001b[C\u001b[90m│\u001b[5C\u001b[m[search index=*\u001b[87C"]
[14.70171, "o", "\u001b[37m┃\r\r\n\u001b[C\u001b[90m│\u001b[6C\u001b[m| where sourcetype=\"portal:auth\"\u001b[69C\u001b[37m┃\r\r\n\u001b[C\u001b[90m│\u001b[23;13H\u001b[mAND result=\"failure\"\u001b[77C\u001b[37m┃\r\r\n\u001b[C\u001b[90m│\u001b[6C\u001b[m| stats count() AS failures\u001b[74C\u001b[37m┃\r\r\n\u001b[C\u001b[90m│\u001b[25;13H\u001b[mBY service, version]\u001b[77C\u001b[37m┃\r\r\n\u001b[C\u001b[90m│\u001b[m | eval service='L.service',\u001b[79C\u001b[37m┃\r\r\n\u001b[C\u001b[90m│\u001b[27;11H\u001b[mversion='L.version',\u001b[79C\u001b[37m┃\r\r\n\u001b[C\u001b[90m│\u001b[28;11H\u001b[mattempts='L.attempts',\u001b[77C\u001b[37m┃\r\r\n\u001b[C\u001b[90m│\u001b[29;11H\u001b[mfailures='R.failures'\u001b[78C\u001b[37m┃\r\r\n\u001b[C\u001b[90m│\u001b[m | eval failure_rate=\u001b[86C\u001b[37m┃\r\r\n\u001b[C\u001b[90m│\u001b[5C\u001b[mround(100*failures/attempts, 1)\u001b[71C\u001b[37m┃\r\r\n\u001b[C\u001b[90m│\u001b[m | fields service, version, attempts,\u001b[70C\u001b[37m┃\r\r\n\u001b[C\u001b[90m│\u001b[33;13H\u001b[mfailures, failure_rate\u001b[75C\u001b[37m┃\r\r\n\u001b[C\u001b[90m│\u001b[m | sort - failure_rate\u001b[85C\u001b[37m┃\r\r\n\u001b[109C┃\u001b[m\r\r\n\r\n\r\n❯ \u001b[?25h"]
