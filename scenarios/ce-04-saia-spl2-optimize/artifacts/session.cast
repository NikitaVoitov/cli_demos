[49.600424, "o", "\u001b[?25l\u001b[3;27r\u001b[27;1H\r\n\r\n\u001b[r\u001b[12;110H┃\r\r\n\u001b[109C┃\r\r\n\u001b[109C┃\r\u001b[24;16HE\r\n   • \u001b[1mRuntime:\u001b[m 91.56 s\r\n   • \u001b[1mEvent count:\u001b[92C\u001b[0;37m┃\r\r\n\u001b[109C┃\u001b[m\r\r\n\r\n\r\n❯ \u001b[?25h"]
