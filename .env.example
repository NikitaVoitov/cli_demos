# Copy to .env (git-ignored) and fill in only what your demo needs. The scripts read this file line by line,
# so keep comments on their own lines (never after a value) and quote values that contain spaces.
# Never commit real values. Demos record against demo or personal sites, never a corporate SaaS tenant.

# --- Default stack (`stack: co2`). The capture also reads ~/.splunkctl/config.yaml and
# --- ~/.cursor/mcp-secrets/splunk-mcp.env (SPLUNK_MCP_AUTH="Bearer <token>"); see README "Stacks".
# Splunk Web login the capture saves a browser session for
SPLUNK_WEB_USER=
SPLUNK_WEB_PASSWORD=
# HEC endpoint and token, used by the scripts/seed_*.py data seeders
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=
# REST bearer token (splunkctl, seeders) and Splunk MCP Server token
SPLUNK_REST_TOKEN=
SPLUNK_MCP_TOKEN=

# --- Another stack (`recording.stackProfile: mdl`). The suffix is the profile name, upper-cased.
# --- `python3 scripts/stack_profile.py init mdl` turns these into .captures/ce01/stacks/mdl/.
# https://<stack>.splunkcloud.com
SPLUNK_WEB_BASE_MDL=
# https://<stack>.splunkcloud.com:8089
SPLUNK_REST_URL_MDL=
SPLUNK_REST_TOKEN_MDL=
SPLUNK_MCP_TOKEN_MDL=
# Optional: seeders, a separate Splunk Web login, the bare stack name the sanitizer masks
# SO-08 demo_soc HEC token
SPLUNK_HEC_TOKEN_MDL=
# SO-03 (scenarios/so-03-notebook-spray-hunt/fixtures/MDL_SETUP.md): HEC tokens for demo_auth and the raw table,
# the Open Sharing profile path, and its share.schema.table. SPLUNK_HEC_URL_MDL defaults to http-inputs-<stack>.
SPLUNK_HEC_TOKEN_IDX_MDL=
SPLUNK_HEC_TOKEN_RAW_MDL=
SPLUNK_SHARE_PROFILE_MDL=
SPLUNK_SHARE_TABLE_MDL=
# SPLUNK_WEB_USER_MDL=
# SPLUNK_WEB_PASSWORD_MDL=
# STACK_ID_MDL=
# Optional: Splunk Cloud Services token (Machine Data Lake demos)
SCS_TOKEN=

# --- EB-03 (Agentic SDK on Vertex AI)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# --- SO-07 (Jira). JIRA_SITE must be a personal *.atlassian.net site; the scripts refuse the corporate host.
JIRA_SITE=
JIRA_EMAIL=
JIRA_TOKEN=

# --- SO-08 (n8n, Slack). SLACK_SOC_BOT_TOKEN is the xoxb- bot token, not the xapp- app-level token.
N8N_URL=
N8N_API_KEY=
N8N_WEBHOOK_TOKEN=
SLACK_SOC_BOT_TOKEN=
